# À copier dans ~/.config/csp-cli/.env (droits 600), jamais dans le dépôt.
# Heure de départ des trajets (heure de Paris, un mardi) ; seuls les départs dans les 2 heures suivantes comptent.
# Le point de départ se règle par recherche : « depart » dans recherches.yaml.
CSP_HEURE_DEPART=08:00

# Résumés (csp resumer) : anthropic (Claude) ou albert (API Albert d'Etalab, compatible OpenAI).
CSP_LLM_FOURNISSEUR=anthropic
# Clé d'API. Pour anthropic, peut rester vide : ANTHROPIC_API_KEY est alors utilisée.
CSP_LLM_CLE=
# Modèle. anthropic : claude-opus-5-5 par défaut. albert : obligatoire (csp doctor liste les modèles disponibles).
CSP_LLM_MODELE=
# anthropic seulement, facultatif : low, medium, high, xhigh, max.
CSP_LLM_EFFORT=
